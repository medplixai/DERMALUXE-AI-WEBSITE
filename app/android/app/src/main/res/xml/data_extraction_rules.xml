<?xml version="1.0" encoding="utf-8"?>
<!-- Patient and lead data must not leave the device in a cloud backup or a
     device-to-device transfer. Nothing from this app is eligible. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
